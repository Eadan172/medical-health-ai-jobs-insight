# 复制为 .env 后按需填写。所有变量也可不设，使用 automation/config.toml 的默认值。
# API Key 不要提交进仓库。

# ---- LLM ----
# JOBSINSIGHT_LLM_PROVIDER=deepseek
# JOBSINSIGHT_LLM_MODEL=deepseek-chat
# JOBSINSIGHT_LLM_API_KEY=
# JOBSINSIGHT_LLM_BASE_URL=

# ---- 运行时间 ----
# JOBSINSIGHT_SCHEDULE_MODE=daily          # daily | cron | interval | manual
# JOBSINSIGHT_SCHEDULE_DAILY_TIMES=00:00
# JOBSINSIGHT_SCHEDULE_CRON=0 0 * * *
# JOBSINSIGHT_SCHEDULE_INTERVAL_MINUTES=360
# JOBSINSIGHT_SCHEDULE_TIMEZONE=Asia/Shanghai
# JOBSINSIGHT_SCHEDULE_ENABLED=true

# ---- HTTP 接口 ----
# JOBSINSIGHT_SERVER_HOST=127.0.0.1
# JOBSINSIGHT_SERVER_PORT=8787
# JOBSINSIGHT_SERVER_AUTH_TOKEN=

# ---- Docker Compose 会读下面这几个短名 ----
# LLM_PROVIDER=mock
# LLM_MODEL=mock-1
# LLM_API_KEY=
# API_TOKEN=
